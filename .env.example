# Copy this file to .env and fill in real values. .env is gitignored.
# Precedence: real environment variables > .env > config.yaml > built-in defaults.

# Required: hostname/IP of your Mosquitto broker (e.g. your Ubuntu/Proxmox VM)
MQTT_BROKER_HOST=

# Optional, default 1883
MQTT_BROKER_PORT=1883

# Optional: omit both for anonymous connections
MQTT_USERNAME=
MQTT_PASSWORD=

# Required: topic prefix your iGate/bridge publishes under (subscribed as "<prefix>/#")
# e.g. aprs
MQTT_TOPIC_PREFIX=
